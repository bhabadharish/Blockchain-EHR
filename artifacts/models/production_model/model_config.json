{
  "model_name": "Proposed Hybrid IDS (MI-CNN-BiLSTM-Attention-Residual)",
  "input_dim": 20,
  "conv_filters": 64,
  "lstm_hidden": 64,
  "attention_heads": 4,
  "dense_dim": 128,
  "dropout": 0.25,
  "use_residual": true,
  "optimal_threshold": 0.5,
  "classes": [
    "Backdoor",
    "DDoS_HTTP",
    "DDoS_ICMP",
    "DDoS_TCP",
    "DDoS_UDP",
    "Fingerprinting",
    "MITM",
    "Normal",
    "Password",
    "Port_Scanning",
    "Ransomware",
    "SQL_injection",
    "Uploading",
    "Vulnerability_scanner",
    "XSS"
  ],
  "binary_classes": [
    "Normal",
    "Attack"
  ],
  "selected_features": [
    "tcp.options",
    "tcp.dstport",
    "tcp.srcport",
    "tcp.ack",
    "tcp.seq",
    "tcp.payload",
    "tcp.ack_raw",
    "tcp.flags",
    "dns.qry.name.len",
    "mqtt.conack.flags",
    "mqtt.protoname",
    "mqtt.topic",
    "mqtt.msg",
    "http.request.version",
    "http.request.method",
    "tcp.len",
    "http.referer",
    "tcp.checksum",
    "http.request.uri.query",
    "tcp.flags.ack"
  ]
}